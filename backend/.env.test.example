# Used by `npm test` (vitest). Points at a separate database so tests never
# touch dev data. Create it once with:
#   docker exec chronosfin-db-1 createdb -U chronosfin chronosfin_test
#   DATABASE_URL="postgresql://chronosfin:chronosfin@localhost:5433/chronosfin_test?schema=public" npx prisma migrate deploy
DATABASE_URL="postgresql://chronosfin:chronosfin@localhost:5433/chronosfin_test?schema=public"
DIRECT_URL="postgresql://chronosfin:chronosfin@localhost:5433/chronosfin_test?schema=public"
PORT=3001
JWT_SECRET=test-secret-do-not-use-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
